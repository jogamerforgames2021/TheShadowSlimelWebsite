Dialogue: 0,0:04:35.63,0:04:38.05,Aizo,,0,0,0,,أصارع في الحب والكراهية
Dialogue: 0,0:04:38.05,0:04:40.13,Aizo,,0,0,0,,أرسم ابتسامة زائفة للمظاهر
Dialogue: 0,0:04:40.13,0:04:40.51,Aizo,,0,0,0,,{\pos(320.667,356.667)}أرسم ابتسامة زائفة للمظاهر
Dialogue: 0,0:04:40.51,0:04:42.80,Aizo,,0,0,0,,{\pos(320.667,356.667)}...في النهاية، لا شيء آخر يهم حقًا
Dialogue: 0,0:04:42.80,0:04:43.01,Aizo,,0,0,0,,...في النهاية، لا شيء آخر يهم حقًا
Dialogue: 0,0:04:43.01,0:04:45.85,Aizo,,0,0,0,,!وداعًا، لنلتقي مجددًا يومًا ما
Dialogue: 0,0:03:28.48,0:03:29.19,Show_Title,Screen,0,0,0,,{\c&H0200E9&\3c&H000000&}‫جوجيتسو كايسن
Dialogue: 0,0:03:52.46,0:03:56.67,Show_Title,Screen,0,0,0,,{\fad(0,650)\c&H2E2C2C&}‫جوجيتسو كايسن\N{\fs12\c&HF3F3F3&\bord0\alpha&HFF&\t(237,736,1 \alpha&H00&)}‫لعبة الإعدام الجزء 1
Dialogue: 0,0:04:48.01,0:04:51.01,Ep_Title,Screen,0,0,0,,‫الحلقة 53\N{\fs30}‫ترس
Dialogue: 0,0:04:55.74,0:04:57.33,Italics,Fushiguro,0,0,0,,‫نحن في حالة جمود!
Dialogue: 0,0:04:57.33,0:04:58.45,Italics,Fushiguro,0,0,0,,‫ممتاز!
Dialogue: 0,0:04:58.90,0:05:00.21,Main,Fushiguro,0,0,0,,‫كيرارا-سان!
Dialogue: 0,0:05:00.21,0:05:03.33,Main,Fushiguro,0,0,0,,‫نحن لسنا فعليًا مع \N‫ثانوية جوجيتسو الآن!
Dialogue: 0,0:05:03.33,0:05:06.40,Main,Fushiguro,0,0,0,,‫أنتِ تعرفين كيف \N‫هو وضع طوكيو الآن، أليس كذلك؟!
Dialogue: 0,0:05:08.54,0:05:11.50,Main,Fushiguro,0,0,0,,‫الحواجز التي ظهرت \N‫في كل منطقة مرتبطة أيضًا!
Dialogue: 0,0:05:11.98,0:05:14.50,Main,Fushiguro,0,0,0,,‫كان هجومًا غير مسبوق من إرهاب الجوجيتسو!
Dialogue: 0,0:05:14.50,0:05:17.00,Main,Fushiguro,0,0,0,,‫نحن بحاجة إلى مساعدة هاكاري-سان!
Dialogue: 0,0:05:17.00,0:05:19.64,Main,Kirara,0,0,0,,‫أنتم من استبعدتمونا أولًا.
Dialogue: 0,0:05:19.64,0:05:21.50,Main,Kirara,0,0,0,,‫تحصدون ما تزرعون.
Dialogue: 0,0:05:21.50,0:05:23.60,Main,Fushiguro,0,0,0,,‫قلتُ لكِ، لسنا مع ثانوية جوجيتسو!
Dialogue: 0,0:05:24.15,0:05:26.03,Main,Fushiguro,0,0,0,,‫ماذا حدث بينكما وبين القيادات العليا؟
Dialogue: 0,0:05:26.03,0:05:28.13,Main,Panda,0,0,0,,‫لقد اشتبكوا مع المحافظين.
Dialogue: 0,0:05:28.13,0:05:33.52,Main,Panda,0,0,0,,‫ومفهومهم عن المحافظين \N‫يتجاوز مجرد سياستهم تجاه اللوائح.
Dialogue: 0,0:05:33.52,0:05:37.27,Main,Panda,0,0,0,,‫لديهم أفكار جامدة \N‫عما يجب أن يكون عليه الجوجيتسو.
Dialogue: 0,0:05:37.51,0:05:40.35,Main,Panda,0,0,0,,‫تقنية كوغيساكي مثال جيد.
Dialogue: 0,0:05:40.35,0:05:43.44,Main,Panda,0,0,0,,‫إنّه النوع الكلاسيكي الذي يحبه المحافظون.
Dialogue: 0,0:05:44.08,0:05:46.83,Main,Panda,0,0,0,,‫ليس مثل أشياء كفيديوهات اللعنات \N‫التي كانت رائجة قبل مدة.
Dialogue: 0,0:05:46.83,0:05:50.32,Main,Panda,0,0,0,,‫ومع مرور الوقت، حتى الجوجيتسو \N‫يُدخل تقنيات أحدث.
Dialogue: 0,0:05:50.76,0:05:53.01,Main,Panda,0,0,0,,‫لكن عندما تبدأ حتى التقنيات بذلك،
Dialogue: 0,0:05:53.01,0:05:54.91,Main,Panda,0,0,0,,‫يبدأ المحافظون بالتذمر.
Dialogue: 0,0:05:55.46,0:05:58.64,Main,Kirara,0,0,0,,‫تقنية كين-تشان مثال مثالي.
Dialogue: 0,0:05:58.64,0:06:01.12,Main,Kirara,0,0,0,,‫تلك القيادات الغبية خسرت بسبب ذلك.
Dialogue: 0,0:06:01.64,0:06:06.32,Main,Kirara,0,0,0,,‫لكنكم دائمًا تستطيعون \N‫أن تجعلوا ساتورو غوجو ينقذكم، أليس كذلك؟
Dialogue: 0,0:06:06.32,0:06:09.15,Main,Kirara,0,0,0,,‫لا أفهم لماذا \N‫تحتاجون للاعتماد علينا.
Dialogue: 0,0:06:09.15,0:06:12.11,Main,Kirara,0,0,0,,‫لذا من الطبيعي أن أفترض \N‫أنكم تكذبون بشأن الاعتماد علينا،
Dialogue: 0,0:06:12.11,0:06:15.35,Main,Kirara,0,0,0,,‫وجئتم لهدف آخر، صحيح؟
Dialogue: 0,0:06:16.39,0:06:18.69,Main,Fushiguro,0,0,0,,‫غوجو-سينسي خُتم.
Dialogue: 0,0:06:34.83,0:06:43.84,Sign_Basic,Screen,0,0,0,,{\fs20\fscx367\fscy375\pos(131.334,-10.999)}{\an8\c&H312729&\b50\shad1\3c&HFFFFFF&\3a&HA0&\pos(320,5)}‫إنها لا تصدقنا!
Dialogue: 0,0:06:19.17,0:06:20.67,Main,Fushiguro,0,0,0,,‫ولهذا خسرنا.
Dialogue: 0,0:06:34.82,0:06:37.04,Main,Panda,0,0,0,,‫إنها لا تصدقنا!
Dialogue: 0,0:06:34.82,0:06:37.04,Main,Fushiguro,0,0,0,,‫إنها لا تصدقنا!
Dialogue: 0,0:06:37.04,0:06:39.59,Italics,Panda,0,0,0,,‫حسنًا، أفهم هذا الشعور.
Dialogue: 0,0:06:39.59,0:06:43.49,Italics,Fushiguro,0,0,0,,‫لكنها الأقرب من هاكاري-سان!
Dialogue: 0,0:06:43.84,0:06:44.84,Italics,Fushiguro,0,0,0,,‫القُواع الهاربة!
Dialogue: 0,0:06:46.08,0:06:47.40,Main,Kirara,0,0,0,,‫أرانب؟
Dialogue: 0,0:06:47.40,0:06:49.12,Italics,Fushiguro,0,0,0,,‫إن استطعنا إقناعها،
Dialogue: 0,0:06:49.12,0:06:51.52,Italics,Fushiguro,0,0,0,,‫فستسير المفاوضات مع هاكاري-سان \N‫بسلاسة أكبر!
Dialogue: 0,0:06:54.94,0:06:56.10,Italics,Fushiguro,0,0,0,,‫أكروكس؟!
Dialogue: 0,0:06:58.47,0:07:00.00,Italics,Fushiguro,0,0,0,,‫غاكروكس؟!
Dialogue: 0,0:07:01.16,0:07:02.54,Italics,Kirara,0,0,0,,‫يا لها من كمية هائلة.
Dialogue: 0,0:07:02.54,0:07:04.14,Italics,Kirara,0,0,0,,‫ما الذي يخطط له؟
Dialogue: 0,0:07:04.74,0:07:08.07,Italics,Kirara,0,0,0,,‫تقنيتي تَسِم الطاقة الملعونة،
Dialogue: 0,0:07:08.35,0:07:11.69,Italics,Kirara,0,0,0,,‫لذا تعامل مستعملي الجوجيتسو\N‫والشيكيغامي خاصتهم ككيان واحد.
Dialogue: 0,0:07:11.69,0:07:15.19,Italics,Kirara,0,0,0,,‫بهذا المعدل، ستنجذب\N‫إليه كما فعل ذلك الكلب،
Dialogue: 0,0:07:15.19,0:07:18.17,Italics,Kirara,0,0,0,,‫وسيسحقه الشيكيغامي خاصته حتى يختنق.
Dialogue: 0,0:07:29.63,0:07:30.77,Main,Fushiguro,0,0,0,,‫باندا-سينباي!
Dialogue: 0,0:07:30.77,0:07:32.14,Main,Fushiguro,0,0,0,,‫كيف كانت القُواع الهاربة؟!
Dialogue: 0,0:07:32.59,0:07:34.47,Main,Panda,0,0,0,,‫كانت الثانية بعدي في الظرافة!
Dialogue: 0,0:07:34.47,0:07:38.14,Main,Fushiguro,0,0,0,,‫أنا أسألك عمّا استطاعت \N‫ولم تستطع الاقتراب منه!
Dialogue: 0,0:07:39.58,0:07:42.56,Main,Panda,0,0,0,,‫استطاعت الاقتراب مني \N‫ومن الطابق الثاني دون مشكلة!
Dialogue: 0,0:07:42.56,0:07:45.24,Main,Panda,0,0,0,,‫لم تستطع الاقتراب من كيرارا \N‫ولا من باب غرفة المراقبة!
Dialogue: 0,0:07:45.87,0:07:49.99,Main,Fushiguro,0,0,0,,‫باندا-سينباي، هل لديك نجمة \N‫واسم في مكان ما بجسدك؟
Dialogue: 0,0:07:52.90,0:07:54.87,Main,Panda,0,0,0,,‫أي.إم. إيه. أي؟
Dialogue: 0,0:07:54.87,0:07:56.19,Italics,Fushiguro,0,0,0,,‫لا بد أن هناك واحدة في مكان ما عليّ...
Dialogue: 0,0:07:56.19,0:07:57.46,Main - Top,Panda,0,0,0,,‫إيما؟ إيما؟ إيماي؟
Dialogue: 0,0:07:57.39,0:07:58.47,Italics,Fushiguro,0,0,0,,‫هناك!
Dialogue: 0,0:07:57.46,0:07:59.21,Main - Top,Panda,0,0,0,,‫مكتوب "إيماي"!
Dialogue: 0,0:07:59.21,0:08:01.32,Italics,Fushiguro,0,0,0,,‫إنها أكروكس، مثل القُواع الهاربة!
Dialogue: 0,0:08:01.78,0:08:03.81,Italics,Fushiguro,0,0,0,,‫ربما هي أيضًا على كلاب الشيطان.
Dialogue: 0,0:08:04.36,0:08:07.49,Italics,Fushiguro,0,0,0,,‫ما زلت لا أعرف شيئًا عنها، لكن ينبغي أن—
Dialogue: 0,0:08:08.77,0:08:10.10,Main,Fushiguro,0,0,0,,‫فهمت!
Dialogue: 0,0:08:10.10,0:08:12.37,Main,Fushiguro,0,0,0,,‫هذه التقنية قائمة على كوكبة!
Dialogue: 0,0:08:12.74,0:08:15.39,Italics,Kirara,0,0,0,,‫من يعرف الكوكبات يمكنه استنتاج ذلك.
Dialogue: 0,0:08:15.39,0:08:17.17,Main,Fushiguro,0,0,0,,‫الكوكبة التي تستند إليها هي...
Dialogue: 0,0:08:22.02,0:08:23.52,Main,Fushiguro,0,0,0,,‫الصليب الجنوبي!
Dialogue: 0,0:08:29.20,0:08:30.07,Main,Kirara,0,0,0,,‫تبًا!
Dialogue: 0,0:08:30.31,0:08:32.72,Italics,Kirara,0,0,0,,‫كلانا أظهرنا ذلك على وجهينا!
Dialogue: 0,0:08:32.62,0:08:45.59,Sign_Basic,Screen,0,0,0,,{\fad(300,0)\an8\b0\c&H000000&\3c&HFFFFFF&\shad0\fs20\bord10\fnAlexandria ExtraBold\3a&H0B&\fscx303\fscy281\pos(565.333,92)}‫حقًّا؟
Dialogue: 0,0:08:32.62,0:08:45.59,Sign_Basic,Screen,0,0,0,,{\fad(300,0)\an8\b0\c&H000000&\3c&HFFFFFF&\shad0\fs20\bord10\fnAlexandria ExtraBold\3a&H0B&\fscx303\fscy281\pos(336.666,92.667)}‫حقًّا؟
Dialogue: 0,0:08:32.72,0:08:35.20,Italics,Kirara,0,0,0,,‫نظراته قالت، "حقًّا؟!"
Dialogue: 0,0:08:35.55,0:08:39.95,Italics,Kirara,0,0,0,,‫لم يكن متأكدًا أن تقنيتي \N‫مبنية على الصليب الجنوبي!
Dialogue: 0,0:08:39.95,0:08:42.77,Italics,Kirara,0,0,0,,‫لكنني أعطيته النظرة نفسها!
Dialogue: 0,0:08:42.77,0:08:44.60,Italics,Kirara,0,0,0,,‫أكدتُ له ذلك!
Dialogue: 0,0:08:45.01,0:08:47.26,Italics,Kirara,0,0,0,,‫إن اكتشف المزيد من تقنيتي،
Dialogue: 0,0:08:47.26,0:08:49.00,Italics,Kirara,0,0,0,,‫سيتمكن من دخول غرفة المراقبة!
Dialogue: 0,0:08:49.71,0:08:51.96,Italics,Kirara,0,0,0,,‫يجب أن أوقفه هنا!
Dialogue: 0,0:08:51.96,0:08:53.79,Italics,Fushiguro,0,0,0,,‫عدنا إلى الجمود مجددًا؟
Dialogue: 0,0:08:56.22,0:08:58.73,Italics,Fushiguro,0,0,0,,‫لكنها فعلًا الصليب الجنوبي؟
Dialogue: 0,0:08:59.56,0:09:01.51,Italics,Fushiguro,0,0,0,,‫أنا ممتن لتسوميكي.
Dialogue: 0,0:09:01.96,0:09:04.04,Italics,Fushiguro,0,0,0,,‫لكنني لا أعرف شيئًا آخر.
Dialogue: 0,0:09:04.04,0:09:07.04,Italics,Fushiguro,0,0,0,,‫وبالمناسبة، أليس الصليب الجنوبي \N‫كوكبة من أربع نجوم؟
Dialogue: 0,0:09:07.04,0:09:08.65,Main,Panda,0,0,0,,‫فوشيغورو!
Dialogue: 0,0:09:09.19,0:09:11.63,Italics,Fushiguro,0,0,0,,‫يمكنني حقًّا الاقتراب من باندا-سينباي.
Dialogue: 0,0:09:12.54,0:09:16.29,Main,Fushiguro,0,0,0,,‫سينباي، الصليب الجنوبي \N‫لها أربع نجوم، صحيح؟
Dialogue: 0,0:09:16.29,0:09:16.92,Main,Panda,0,0,0,,‫ماذا؟
Dialogue: 0,0:09:16.92,0:09:18.65,Main,Panda,0,0,0,,‫حسنًا، صليب.
Dialogue: 0,0:09:19.32,0:09:21.23,Main,Fushiguro,0,0,0,,‫نعم، هذا منطقي.
Dialogue: 0,0:09:26.12,0:09:30.79,Main,Fushiguro,0,0,0,,‫تقنية كيرارا-سان تطبّق نجمة من \N‫الصليب الجنوبي على كل واحد منا،
Dialogue: 0,0:09:30.79,0:09:34.03,Main,Fushiguro,0,0,0,,‫وظننت أنها ربما تستخدم ذلك \N‫لفرض مسافة معينة بيننا.
Dialogue: 0,0:09:34.03,0:09:36.86,Main,Fushiguro,0,0,0,,‫لكن كيرارا-سان تستطيع الاقتراب من الباب،
Dialogue: 0,0:09:36.86,0:09:39.51,Main,Fushiguro,0,0,0,,‫وأنتَ وأنا نستطيع الاقتراب من بعضنا.
Dialogue: 0,0:09:39.51,0:09:45.35,Main - Top,Panda,0,0,0,,‫ربما ببساطة نجمتا كيرارا \N‫والباب تنفّران نجمتينا؟
Dialogue: 0,0:09:41.89,0:09:44.85,Sign_Basic,screen,0,0,0,,{\b0\bord5\shad1\fs18\1a&H22&\fnAlexandria ExtraBold\3c&H372418&\fscx141\fscy146\pos(320,341.333)}‫"نظرية الصليب"
Dialogue: 0,0:09:45.66,0:09:47.32,Main,Fushiguro,0,0,0,,‫لو كان ذلك صحيحًا،
Dialogue: 0,0:09:47.32,0:09:50.24,Main,Fushiguro,0,0,0,,‫لكان من الأنسب لكيرارا-سان \N‫أن تهرب إلى داخل غرفة المراقبة.
Dialogue: 0,0:09:50.24,0:09:51.63,Main,Panda,0,0,0,,‫صحيح.
Dialogue: 0,0:09:51.63,0:09:54.77,Main,Panda,0,0,0,,‫لو التصقت بالجانب الداخلي \N‫للباب، لكنا عالقين.
Dialogue: 0,0:09:55.75,0:09:57.60,Main,Panda,0,0,0,,‫إذًا ماذا عن هذا؟
Dialogue: 0,0:09:58.13,0:10:03.65,Main,Panda,0,0,0,,‫النجمة أ تستطيع الاقتراب \N‫من النجمة ب، لكن ب لا تستطيع الاقتراب من أ.
Dialogue: 0,0:10:03.65,0:10:06.75,Main,Panda,0,0,0,,‫لكل نجمة واحدة متوافقة معها،
Dialogue: 0,0:10:06.75,0:10:09.55,Main,Panda,0,0,0,,‫ولا يمكنها الاقتراب إلا منها.
Dialogue: 0,0:10:09.54,0:10:11.38,Sign_Basic,Screen,0,0,0,,{\b0\bord5\shad1\fs18\1a&H22&\fnAlexandria ExtraBold\3c&H372418&\fscx141\fscy146\pos(320,338.667)}‫"نظرية حجر ورقة مقص"
Dialogue: 0,0:10:09.55,0:10:10.38,Main - Top,Panda,0,0,0,,‫مثل حجر-ورقة-مقص.
Dialogue: 0,0:10:11.39,0:10:16.55,Main,Fushiguro,0,0,0,,‫لكن أنا وأت نستطيع الاقتراب \N‫من بعضنا بحرية.
Dialogue: 0,0:10:16.89,0:10:18.41,Main,Panda,0,0,0,,‫إذًا الأمر ليس كذلك.
Dialogue: 0,0:10:20.55,0:10:23.32,Main,Fushiguro,0,0,0,,‫أظنها مثل جمع الطوابع،
Dialogue: 0,0:10:23.32,0:10:26.32,Main,Fushiguro,0,0,0,,‫حيث يجب اتباع مسار محدد \N‫والاقتراب من كل واحد بالترتيب.
Dialogue: 0,0:10:26.93,0:10:29.21,Main - Top,Fushiguro,0,0,0,,‫كما أن الأشياء التي تحمل \N‫النجمة نفسها تنجذب إلى بعضها.
Dialogue: 0,0:10:28.77,0:10:30.27,Sign_Basic,Screen,0,0,0,,{\b0\bord5\shad1\fs18\1a&H22&\fnAlexandria ExtraBold\3c&H372418&\fscx141\fscy146\pos(314.667,337.333)}‫"نظرية جمع الطوابع"
Dialogue: 0,0:10:30.26,0:10:31.89,Main,Panda,0,0,0,,‫فهمت.
Dialogue: 0,0:10:31.89,0:10:35.36,Main,Panda,0,0,0,,‫لكن ماذا لو لم يكن مستعمل الجوجيتسو يُعتبر كهدف؟
Dialogue: 0,0:10:35.36,0:10:37.00,Main,Fushiguro,0,0,0,,‫هذا لا يمكن.
Dialogue: 0,0:10:37.00,0:10:39.54,Main,Fushiguro,0,0,0,,‫أُجربت على الابتعاد من كلاب الشيطان أيضًا.
Dialogue: 0,0:10:40.24,0:10:42.01,Main,Fushiguro,0,0,0,,‫حاليًا كيرارا-سان
Dialogue: 0,0:10:42.01,0:10:44.11,Main,Fushiguro,0,0,0,,‫تخشى أن نتمّ شرطًا ما
Dialogue: 0,0:10:44.48,0:10:49.80,Main,Fushiguro,0,0,0,,‫بعيدًا عن نظرها ضروري لدخول غرفة المراقبة.
Dialogue: 0,0:10:50.12,0:10:53.24,Main,Panda,0,0,0,,‫إذًا هناك خمس نجوم أو أكثر.
Dialogue: 0,0:10:53.24,0:10:53.93,Main,Fushiguro,0,0,0,,‫صحيح.
Dialogue: 0,0:10:54.64,0:10:57.38,Main,Fushiguro,0,0,0,,‫إن كانت نظرية جمع الطوابع صحيحة،
Dialogue: 0,0:10:57.38,0:11:02.07,Main,Fushiguro,0,0,0,,‫فينبغي أن نتمكن من الاقتراب \N‫من كيرارا-سان إن كانت هناك أربع نجوم فقط.
Dialogue: 0,0:11:02.07,0:11:04.44,Main,Fushiguro,0,0,0,,‫لذا لا بد من وجود نجمة خامسة
Dialogue: 0,0:11:04.44,0:11:07.78,Main,Fushiguro,0,0,0,,‫علينا المرور بها \N‫للوصول إلى كيرارا-سان والباب.
Dialogue: 0,0:11:08.34,0:11:10.72,Main,Panda,0,0,0,,‫وماذا لو كانت هناك ست أو سبع نجوم؟
Dialogue: 0,0:11:10.72,0:11:13.47,Main,Fushiguro,0,0,0,,‫أود أن أعتقد أنّ ذلك غير صحيح.
Dialogue: 0,0:11:13.47,0:11:16.14,Main,Fushiguro,0,0,0,,‫الأمر مربك بما يكفي \N‫بوجود خمس نجوم في صليب.
Dialogue: 0,0:11:16.14,0:11:17.15,Main,Kirara,0,0,0,,‫إن اكتشفا الأمر،
Dialogue: 0,0:11:18.41,0:11:19.39,Main,Kirara,0,0,0,,‫فسأهاجم!
Dialogue: 0,0:11:27.91,0:11:28.92,Main,Fushiguro,0,0,0,,‫باندا-سينباي!
Dialogue: 0,0:11:31.13,0:11:32.57,Main,Panda,0,0,0,,‫أنا بخير!
Dialogue: 0,0:11:32.57,0:11:33.74,Main,Panda,0,0,0,,‫لا تقلق عليّ!
Dialogue: 0,0:11:33.74,0:11:36.77,Main,Panda,0,0,0,,‫فوشيغورو! اعثر على النجمة!
Dialogue: 0,0:11:40.82,0:11:43.14,Main,Fushiguro,0,0,0,,‫لا يمكنك رميها!
Dialogue: 0,0:11:47.76,0:11:50.92,Main,Fushiguro,0,0,0,,‫وضعت نفس نجمة إيماي على تلك السيارة!
Dialogue: 0,0:11:50.92,0:11:52.54,Main,Fushiguro,0,0,0,,‫إن رميتها ستعود
Dialogue: 0,0:11:52.54,0:11:55.24,Main,Fushiguro,0,0,0,,‫أو تجذبك إليها، كما فعلت كلاب الشيطان معي!
Dialogue: 0,0:11:55.24,0:11:58.55,Italics,Fushiguro,0,0,0,,‫ربما عليها لمس الهدف لزرع نجمة ما.
Dialogue: 0,0:11:59.05,0:12:02.28,Italics,Fushiguro,0,0,0,,‫لكن كيرارا-سان لم تلمسني \N‫ولا القُواع الهاربة!
Dialogue: 0,0:12:03.23,0:12:05.00,Italics,Fushiguro,0,0,0,,‫لمست كلاب الشيطان فقط.
Dialogue: 0,0:12:05.00,0:12:09.00,Italics,Fushiguro,0,0,0,,‫هذا يعني أن كيرارا-سان تسم\N‫الطاقة الملعونة، لا الأشياء!
Dialogue: 0,0:12:09.29,0:12:12.07,Italics,Fushiguro,0,0,0,,‫ولوسم الأبواب والسيارات،
Dialogue: 0,0:12:12.07,0:12:15.53,Italics,Fushiguro,0,0,0,,‫لا بدّ أنّها احتاجت شخصًا يغمرها بطاقة ملعونة مسبقًا!
Dialogue: 0,0:12:19.83,0:12:20.96,Italics,Fushiguro,0,0,0,,‫عرفت ذلك!
Dialogue: 0,0:12:22.14,0:12:24.98,Italics,Fushiguro,0,0,0,,‫السيارة تحمل بقايا طاقة \N‫ملعونة من شخص آخر!
Dialogue: 0,0:12:25.44,0:12:27.74,Italics,Fushiguro,0,0,0,,‫إن لم تكن التقنية تغطي نطاقًا واسعًا،
Dialogue: 0,0:12:27.74,0:12:29.60,Italics,Fushiguro,0,0,0,,‫فآثار النجمة الأخرى يجب أن تكون...
Dialogue: 0,0:12:41.73,0:12:42.58,Italics,Fushiguro,0,0,0,,‫هناك!
Dialogue: 0,0:12:42.58,0:12:44.00,Italics,Fushiguro,0,0,0,,‫النجمة الخامسة!
Dialogue: 0,0:12:44.83,0:12:48.20,Italics,Fushiguro,0,0,0,,‫لا أرى أي آثار أخرى من شخص غيرنا.
Dialogue: 0,0:12:48.20,0:12:51.33,Italics,Fushiguro,0,0,0,,‫كيرارا-سان وسمت طاقتها الملعونة بالفعل،
Dialogue: 0,0:12:51.33,0:12:54.41,Italics,Fushiguro,0,0,0,,‫لذا لا يمكنها استخدام طاقتها \N‫الملعونة الخاصة
Dialogue: 0,0:12:54.41,0:12:56.47,Italics,Fushiguro,0,0,0,,‫لوسم الأشياء بنفس نجمة أكروكس \N‫التي أعطتني إياها.
Dialogue: 0,0:12:56.47,0:12:59.62,Italics,Fushiguro,0,0,0,,‫وهذا يعني أنها لا تستطيع \N‫قذف الأشياء نحوي كما فعلت بتلك السيارة!
Dialogue: 0,0:13:01.13,0:13:03.73,Italics,Fushiguro,0,0,0,,‫بمجرد أن ألمس ذلك، سأستطيع الاقتراب \N‫من كيرارا-سان!
Dialogue: 0,0:13:05.73,0:13:08.06,Narration,Narrator,0,0,0,,‫كانت فرضية فوشيغورو صحيحة.
Dialogue: 0,0:13:09.04,0:13:11.81,Narration,Narrator,0,0,0,,‫تقنية كيرارا الملعونة، موعد الحب،
Dialogue: 0,0:13:11.81,0:13:17.73,Narration,Narrator,0,0,0,,‫توزّع خمس نجوم على طاقة الأهداف \N‫الملعونة اعتمادًا على الصليب الجنوبي.
Dialogue: 0,0:13:18.80,0:13:21.64,Narration,Narrator,0,0,0,,‫لكي تقترب نجمة من أخرى،
Dialogue: 0,0:13:21.64,0:13:24.48,Narration,Narrator,0,0,0,,‫يجب اتباع ترتيب محدد مسبقًا،
Dialogue: 0,0:13:24.48,0:13:28.12,Narration,Narrator,0,0,0,,‫والأشياء التي تحمل النجمة نفسها \N‫تنجذب إلى بعضها.
Dialogue: 0,0:13:28.97,0:13:30.63,Main,Kirara,0,0,0,,‫أنت مذهل.
Dialogue: 0,0:13:30.63,0:13:33.49,Main,Kirara,0,0,0,,‫لقد اكتشفت تقنيتي فعلًا.
Dialogue: 0,0:13:33.88,0:13:35.12,Main,Fushiguro,0,0,0,,‫باندا-سينباي!
Dialogue: 0,0:13:49.57,0:13:52.89,Narration,Narration,0,0,0,,‫ذلك الترتيب كان من أقرب نجمة \N‫إلى أبعدها.
Dialogue: 0,0:13:53.35,0:13:57.20,Narration,Narration,0,0,0,,‫قد تبدو الكوكبات مسطّحة، لكن بالطبع لها عمق،
Dialogue: 0,0:13:57.20,0:14:00.47,Narration,Narration,0,0,0,,‫وكل نجمة لها \N‫مسافة مختلفة عن الأرض.
Dialogue: 0,0:14:00.83,0:14:02.15,Main,Kirara,0,0,0,,‫لكنّك ذكي أكثر من اللازم،
Dialogue: 0,0:14:02.15,0:14:05.91,Main,Kirara,0,0,0,,‫وقررت أنني لم أعد أستطيع \N‫رمي الأشياء عليك، أليس كذلك؟
Dialogue: 0,0:14:05.91,0:14:09.68,Main,Kirara,0,0,0,,‫يمكنني فقط رفع نجمة غينان \N‫الموضوعة على طاقتي الملعونة،
Dialogue: 0,0:14:09.68,0:14:13.12,Main,Kirara,0,0,0,,‫ووسم الأشياء بنفس نجمة أكروكس \N‫التي عليك!
Dialogue: 0,0:14:19.46,0:14:21.67,Italics,Kirara,0,0,0,,‫ما هذا؟!
Dialogue: 0,0:14:22.55,0:14:23.37,Italics,Kirara,0,0,0,,‫كيف؟!
Dialogue: 0,0:14:23.37,0:14:24.69,Italics,Kirara,0,0,0,,‫من أين جاء؟!
Dialogue: 0,0:14:24.69,0:14:26.54,Italics,Kirara,0,0,0,,‫لا، فهمت! ذلك الفتى
Dialogue: 0,0:14:27.16,0:14:30.67,Italics,Kirara,0,0,0,,‫لم يُلغ الشيكيغامي الكلب خاصته قطّ!
Dialogue: 0,0:14:30.67,0:14:31.87,Italics,Kirara,0,0,0,,‫هل اكتشف أيّ الأشياء
Dialogue: 0,0:14:31.87,0:14:34.18,Italics,Kirara,0,0,0,,‫الموسومة بالطريقة نفسها ستنجذب إلى الأخرى؟!
Dialogue: 0,0:14:34.54,0:14:37.16,Italics,Kirara,0,0,0,,‫ثم وضع جدارًا بينه وبين الشيكيغامي،
Dialogue: 0,0:14:37.16,0:14:40.31,Italics,Kirara,0,0,0,,‫كي ينجذب الشيكيغامي إلى الجدار،
Dialogue: 0,0:14:40.73,0:14:44.26,Italics,Kirara,0,0,0,,‫وأطلق الكلب عندما كنتُ \N‫في خط مستقيم بينهما!
Dialogue: 0,0:14:45.10,0:14:47.40,Italics,Kirara,0,0,0,,‫موعد الحب، إلغاء!
Dialogue: 0,0:15:06.12,0:15:08.72,Main,Fushiguro,0,0,0,,‫استمعي إلينا رجاءً.
Dialogue: 0,0:15:11.19,0:15:13.98,Show_Title,screen,0,0,0,,‫جوجيتسو كايسن
Dialogue: 0,0:15:16.64,0:15:18.97,Show_Title,screen,0,0,0,,‫جوجيتسو كايسن
Dialogue: 0,0:15:22.39,0:15:26.10,Main,Kirara,0,0,0,,‫هل رتبت ذلك عمدًا حقًّا؟
Dialogue: 0,0:15:26.10,0:15:29.81,Main,Kirara,0,0,0,,‫لم يكن بإمكانك معرفة إن كنت أنت\N‫أو الكلب ستتجهان نحو الآخر.
Dialogue: 0,0:15:29.81,0:15:32.46,Main,Fushiguro,0,0,0,,‫جازفت، لكني الآن متأكد.
Dialogue: 0,0:15:32.87,0:15:35.77,Main,Fushiguro,0,0,0,,‫الذي يملك طاقة ملعونة أكبر \N‫يجذب الآخر نحوه، صحيح؟
Dialogue: 0,0:15:36.57,0:15:39.37,Main,Fushiguro,0,0,0,,‫في المرة الأولى \N‫انجذبتُ إلى كلاب الشيطان،
Dialogue: 0,0:15:39.37,0:15:43.32,Main,Fushiguro,0,0,0,,‫لكن عندما عززت طاقتي الملعونة \N‫لأحمي نفسي من هجومك،
Dialogue: 0,0:15:43.32,0:15:44.96,Main,Fushiguro,0,0,0,,‫حدث العكس.
Dialogue: 0,0:15:45.69,0:15:47.72,Main,Kirara,0,0,0,,‫هل أنت فعلًا في السنة أولى؟
Dialogue: 0,0:15:47.72,0:15:49.64,Main,Kirara,0,0,0,,‫أنت لست ظريفًا على الإطلاق.
Dialogue: 0,0:15:54.43,0:15:57.44,Main,Fushiguro,0,0,0,,‫رجاءً، لا وقت لدينا.
Dialogue: 0,0:15:57.44,0:15:59.07,Main,Fushiguro,0,0,0,,‫رجاءً اسمعينا.
Dialogue: 0,0:16:01.07,0:16:02.55,Main,Kirara,0,0,0,,‫حسنًا.
Dialogue: 0,0:16:10.71,0:16:12.05,Main,Fushiguro,0,0,0,,‫إيتادوري؟!
Dialogue: 0,0:16:12.05,0:16:14.32,Main,Yuji,0,0,0,,‫فوشيغورو، باندا-سينباي.
Dialogue: 0,0:16:14.92,0:16:16.75,Main,Yuji,0,0,0,,‫لا تتدخلا!
Dialogue: 0,0:16:28.99,0:16:31.12,Main,Hakari,0,0,0,,‫هل تستهين بي؟
Dialogue: 0,0:16:33.13,0:16:33.97,Main,Fushiguro,0,0,0,,‫مباشرة إلى الوجه!
Dialogue: 0,0:16:36.35,0:16:39.10,Italics,Hakari,0,0,0,,‫هذا الوغد! إنه لا—
Dialogue: 0,0:16:39.10,0:16:41.11,Italics,Hakari,0,0,0,,‫لا يحاول حتى تفادي الضربات!
Dialogue: 0,0:16:41.11,0:16:42.72,Main,Hakari,0,0,0,,‫أنت مجنون.
Dialogue: 0,0:16:43.56,0:16:46.37,Italics,Yuji,0,0,0,,‫هذا ليس مثل قتال شيبويا!
Dialogue: 0,0:16:46.78,0:16:49.81,Italics,Yuji,0,0,0,,‫هذا في الأساس طقسٌ لجعل هاكاري-سينباي
Dialogue: 0,0:16:49.81,0:16:51.36,Italics,Yuji,0,0,0,,‫يعترف بي.
Dialogue: 0,0:16:52.16,0:16:53.64,Italics,Yuji,0,0,0,,‫لن أراوغ بعد الآن.
Dialogue: 0,0:16:53.64,0:16:55.25,Italics,Yuji,0,0,0,,‫ولن أقاتل!
Dialogue: 0,0:16:57.16,0:16:59.63,Italics,Yuji,0,0,0,,‫حتى يرضخ!
Dialogue: 0,0:16:59.63,0:17:02.62,Main,Hakari,0,0,0,,‫مثير للاهتمام! سأستمع إليك...
Dialogue: 0,0:17:03.09,0:17:05.19,Main,Hakari,0,0,0,,‫طالما أنك ما زلت واقفًا!
Dialogue: 0,0:17:05.19,0:17:06.22,Main,Kirara,0,0,0,,‫كين-تشان!
Dialogue: 0,0:17:06.22,0:17:08.83,Main,Kirara,0,0,0,,‫هؤلاء الأطفال يريدون مساعدتك فقط!
Dialogue: 0,0:17:08.83,0:17:10.83,Main,Kirara,0,0,0,,‫استمع لهم!
Dialogue: 0,0:17:10.83,0:17:12.87,Main,Hakari,0,0,0,,‫قلت أني سأستمع!
Dialogue: 0,0:17:19.07,0:17:22.98,Main,Hakari,0,0,0,,‫أخبرني يا إيتادوري، لمَ أنا؟!
Dialogue: 0,0:17:22.98,0:17:25.39,Main,Hakari,0,0,0,,‫هذه أول مرة نلتقي، صحيح؟!
Dialogue: 0,0:17:25.87,0:17:27.92,Main,Hakari,0,0,0,,‫فلمَ الاعتماد علي؟!
Dialogue: 0,0:17:28.84,0:17:30.67,Main,Yuji,0,0,0,,‫لأن كل سينباي
Dialogue: 0,0:17:30.67,0:17:32.91,Main,Yuji,0,0,0,,‫قال أنّك قوي.
Dialogue: 0,0:17:34.18,0:17:36.24,Main,Hakari,0,0,0,,‫توقعت ذلك.
Dialogue: 0,0:17:36.73,0:17:39.32,Main,Hakari,0,0,0,,‫عندما يطلب مستعمل جوجيتسو المساعدة\N‫من مستعمل جوجيتسو آخر،
Dialogue: 0,0:17:39.32,0:17:42.78,Main,Hakari,0,0,0,,‫فهذا يعني ضمنًا \N‫أنه يطلب منه المجازفة بحياته معه!
Dialogue: 0,0:17:44.03,0:17:48.96,Main,Hakari,0,0,0,,‫لذا عليك أن تُريني أن لديك \N‫الشغف الذي يستحق أن أخاطر بحياتي لأجله!
Dialogue: 0,0:17:48.96,0:17:52.68,Main,Hakari,0,0,0,,‫هنا والآن!
Dialogue: 0,0:17:52.68,0:17:57.18,Main,Hakari,0,0,0,,‫ومع ذلك تقول لي أنك هنا تنفذ الأوامر دونه!
Dialogue: 0,0:17:57.18,0:17:59.13,Main,Hakari,0,0,0,,‫بماذا كان العجوز ياغا يفكر؟!
Dialogue: 0,0:17:59.13,0:18:01.18,Main,Hakari,0,0,0,,‫كان عليه أن يستبعد الفاشلين مثلك!
Dialogue: 0,0:18:04.90,0:18:06.68,Main,Yuji,0,0,0,,‫لا أملك أي شغف.
Dialogue: 0,0:18:06.98,0:18:07.63,Main,Hakari,0,0,0,,‫ماذا؟
Dialogue: 0,0:18:08.09,0:18:09.65,Main,Yuji,0,0,0,,‫أنا مسنّن.
Dialogue: 0,0:18:10.49,0:18:16.56,Main,Yuji,0,0,0,,‫مسنّن في آلة يحتاجها مستعملو\N‫الجوجيتسو لمواصلة طرد اللعنات.
Dialogue: 0,0:18:17.61,0:18:20.29,Main,Hakari,0,0,0,,‫مهلًا، مهلًا، مهلًا. هل أنت جاد؟
Dialogue: 0,0:18:20.87,0:18:23.12,Main,Hakari,0,0,0,,‫هذا مخيّب للغاية.
Dialogue: 0,0:18:23.49,0:18:25.50,Main,Fushiguro,0,0,0,,‫هذا سيئ! إيتادوري، هذا يكفي!
Dialogue: 0,0:18:41.56,0:18:42.78,Main,Hakari,0,0,0,,‫مؤلم، أليس كذلك؟
Dialogue: 0,0:18:43.22,0:18:44.80,Main,Hakari,0,0,0,,‫بحسب غوجو-سان،
Dialogue: 0,0:18:45.37,0:18:49.06,Main,Hakari,0,0,0,,‫طاقتي الملعونة أخشن من طاقة الآخرين.
Dialogue: 0,0:18:51.90,0:18:53.54,Main,Hakari,0,0,0,,‫هل متَّ؟
Dialogue: 0,0:18:55.81,0:18:57.22,Main,Hakari,0,0,0,,‫يا باندا!
Dialogue: 0,0:18:57.22,0:18:58.89,Main,Hakari,0,0,0,,‫يا رأس قنفذ البحر!
Dialogue: 0,0:18:58.89,0:19:02.64,Main,Hakari,0,0,0,,‫خذ إيتادوري وارحلوا. لا تعودوا—
Dialogue: 0,0:19:04.43,0:19:05.43,Main,Hakari,0,0,0,,‫ماذا؟!
Dialogue: 0,0:19:07.28,0:19:09.68,Italics,Hakari,0,0,0,,‫تلقى ثلاث ضربات دون حماية!
Dialogue: 0,0:19:09.68,0:19:11.50,Italics,Hakari,0,0,0,,‫وقد ضربته كثيرًا قبل ذلك أيضًا!
Dialogue: 0,0:19:11.98,0:19:14.26,Main,Hakari,0,0,0,,‫ممَّ أنت مصنوع؟
Dialogue: 0,0:19:14.68,0:19:16.59,Main,Yuji,0,0,0,,‫أنا مسنّن.
Dialogue: 0,0:19:16.59,0:19:18.68,Main,Yuji,0,0,0,,‫والمسنّنات لها وظيفة كما تعلم.
Dialogue: 0,0:19:19.78,0:19:22.84,Main,Yuji,0,0,0,,‫وظيفتي هي الاستمرار في طرد اللعنات.
Dialogue: 0,0:19:22.84,0:19:25.86,Main,Yuji,0,0,0,,‫إن كنتَ ضروريًا لتحقيق ذلك،
Dialogue: 0,0:19:26.24,0:19:28.85,Main,Yuji,0,0,0,,‫فسأسايرك حتى توافق.
Dialogue: 0,0:19:42.70,0:19:43.79,Main,Yuji,0,0,0,,‫سينباي.
Dialogue: 0,0:19:44.76,0:19:46.70,Main,Yuji,0,0,0,,‫ما هي وظيفتك؟
Dialogue: 0,0:19:47.51,0:19:48.78,Italics,Hakari,0,0,0,,‫هذا الفتى!
Dialogue: 0,0:19:49.93,0:19:52.41,Italics,Hakari,0,0,0,,‫إذًا هذا شغف مسنّن؟!
Dialogue: 0,0:19:56.54,0:19:58.83,Main,Hakari,0,0,0,,‫حسنًا. سأستمر في اللكم—
Dialogue: 0,0:19:58.83,0:20:00.04,Main,Kirara,0,0,0,,‫كين-تشان.
Dialogue: 0,0:20:00.50,0:20:02.65,Main,Kirara,0,0,0,,‫لقد أشعل حماسك، أليس كذلك؟
Dialogue: 0,0:20:06.78,0:20:09.38,Italics,Hakari,0,0,0,,‫الشغف لا يكذب أبدًا!
Dialogue: 0,0:20:13.19,0:20:14.86,Main,Hakari,0,0,0,,‫أنتم، انزلوا إلى هنا.
Dialogue: 0,0:20:16.70,0:20:18.15,Main,Hakari,0,0,0,,‫لنعقد صفقة.
Dialogue: 0,0:20:20.22,0:20:22.46,Main,Fushiguro,0,0,0,,‫ماذا؟ هل انتهى الأمر؟
Dialogue: 0,0:20:23.03,0:20:25.25,Main,Fushiguro,0,0,0,,‫هل أقنعته للتو؟
Dialogue: 0,0:20:25.25,0:20:26.13,Main,Kirara,0,0,0,,‫نعم.
Dialogue: 0,0:20:26.13,0:20:27.78,Main,Fushiguro,0,0,0,,‫شكرًا لك؟
Dialogue: 0,0:20:27.78,0:20:28.72,Main,Kirara,0,0,0,,‫على الرحب.
Dialogue: 0,0:20:29.18,0:20:31.65,Main,Kirara,0,0,0,,‫قد نكره القيادات العليا،
Dialogue: 0,0:20:31.65,0:20:37.12,Main,Kirara,0,0,0,,‫لكن كين-تشان كان دائمًا يشتعل حماسةً\N‫عندما يساعد الآخرين في ثانوية جوجيتسو.
Dialogue: 0,0:20:38.23,0:20:38.85,Main,Yuji,0,0,0,,‫آه!
Dialogue: 0,0:20:42.58,0:20:43.53,Main,Yuji,0,0,0,,‫ماذا؟!
Dialogue: 0,0:20:47.00,0:20:52.01,Main,Kogane,0,0,0,,‫أضاف لاعب قاعدة جديدة إلى لعبة الإعدام!
Dialogue: 0,0:20:52.01,0:20:55.90,Main,Kogane,0,0,0,,‫القاعدة 9: يمكن للاعبين عرض \N‫المعلومات التالية عن اللاعبين الآخرين:
Dialogue: 0,0:20:55.90,0:21:02.44,Main,Kogane,0,0,0,,‫الاسم، النقاط، عدد القواعد \N‫المضافة، المستعمرة الحالية.
Dialogue: 0,0:21:03.24,0:21:05.45,Onscreen2,Screen,0,0,0,,{\fad(0,125)\an8\3a&H00&}‫8: اللاعبون الذي لا يظهرون أي تغيير في النقاط\N‫خلال 19 يومًا من الانضمام أو الحصول على النقاط\N‫سيُجرّدون من تقنيتهم
Dialogue: 0,0:21:05.45,0:21:08.82,Onscreen2,Screen,0,0,0,,{\an8\fad(250,0)\3a&H00&}‫9: يمكن للاعبين عرض المعلومات التالية عن اللاعبين الآخرين\N‫الاسم، النقاط، عدد القواعد المضافة، المستعرة الحالية.
Dialogue: 0,0:21:07.90,0:21:10.34,Flashback,Kogane,0,0,0,,‫لقد حصلتَ على خمس نقاط.
Dialogue: 0,0:21:10.83,0:21:13.24,Flashback,Kashimo,0,0,0,,‫بالطبع قتلته.
Dialogue: 0,0:21:16.94,0:21:20.51,Flashback,Kashimo,0,0,0,,‫كل واحد من هؤلاء ضعيف جدًا.
Dialogue: 0,0:21:20.51,0:21:23.46,Flashback,Kashimo,0,0,0,,‫كان الأمر أفضل قبل 400 عام.
Dialogue: 0,0:21:25.60,0:21:28.02,Flashback,Kashimo,0,0,0,,‫أين أنت يا سوكونا؟
Dialogue: 0,0:21:32.81,0:21:35.38,Flashback,Kogane,0,0,0,,‫لقد تجاوزتَ 200 نقطة.
Dialogue: 0,0:21:35.38,0:21:40.01,Flashback,Kogane,0,0,0,,‫هل تودّ استهلاك 100 نقطة \N‫لإضافة قاعدة إلى لعبة الإعدام؟
Dialogue: 0,0:21:40.63,0:21:43.18,Flashback,Kashimo,0,0,0,,‫صحيح، القواعد.
Dialogue: 0,0:21:43.90,0:21:48.26,Flashback,Kashimo,0,0,0,,‫لو عرفت أسماءهم، والنقاط ستظهر قوتهم...
Dialogue: 0,0:21:49.34,0:21:52.65,Flashback,Kashimo,0,0,0,,‫لكن النقاط تنقص عند إضافة قاعدة.
Dialogue: 0,0:21:52.65,0:21:55.25,Flashback,Kashimo,0,0,0,,‫لذا سأحتاج أيضًا عدد القواعد \N‫التي أضافوها.
Dialogue: 0,0:21:55.96,0:21:58.86,Flashback,Kashimo,0,0,0,,‫وأيضًا أي مستعمرة هم فيها.
Dialogue: 0,0:21:59.57,0:22:00.72,Flashback,Kashimo,0,0,0,,‫كوغاني.
Dialogue: 0,0:22:00.72,0:22:02.20,Flashback,Kashimo,0,0,0,,‫أضف قاعدة.
Dialogue: 0,0:22:02.20,0:22:05.08,Flashback,Kashimo,0,0,0,,‫اكشف تلك المعلومات لكل لاعب.
Dialogue: 0,0:22:05.34,0:22:08.80,Sign_Basic,Screen,0,0,0,,{\b0\bord5\shad3\fs20\1a&H22&\fnAlexandria Black\3c&HCB9275&\4c&H7F5B3E&\fscx143\fscy158\pos(295.333,311)}‫لاعب لعبة الإعدام هاجيمي كاشيمو
Dialogue: 0,0:23:41.84,0:23:43.93,Main,Kenjaku,0,0,0,,‫أنت في الفضاء بين الحلم والواقع.
Dialogue: 0,0:23:43.93,0:23:45.06,Main,Kenjaku,0,0,0,,‫إنها لعنة.
Dialogue: 0,0:23:45.06,0:23:46.66,Main,Yuji,0,0,0,,‫كيف تعرف اسمي؟
Dialogue: 0,0:23:46.66,0:23:47.78,Main,Fushiguro,0,0,0,,‫أنا لست مثل إيتادوري.
Dialogue: 0,0:23:47.78,0:23:50.64,Main,Kogane,0,0,0,,‫بمجرد أن تطأ قدمك إلى الداخل، \N‫تصبح أنت أيضًا لاعبًا!
Dialogue: 0,0:23:50.64,0:23:53.72,Main,Fushiguro,0,0,0,,‫...واجعلهم يضيفون قاعدة \N‫تسمح لتسوميكي بالهرب من لعبة الإعدام!
Comment: 0,0:26:42.79,0:26:42.83,Yaoke,,0,0,0,,indicator
