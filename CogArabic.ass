Dialogue: 0,0:00:02.04,0:00:04.45,Main,Guard A,0,0,0,,{\pos(328.667,36.667)}‫الجو بارد للغاية!
Dialogue: 0,0:00:05.01,0:00:07.55,Main,Guard A,0,0,0,,{\pos(326,36.667)}‫إلى متى سيستمرون اليوم.
Dialogue: 0,0:00:08.67,0:00:12.37,Main,Guard A,0,0,0,,{\pos(328.667,68)}‫لم آكل شيئًا منذ \N‫هذا الصباح وأنا أتضور جوعًا.
Dialogue: 0,0:00:13.42,0:00:16.03,Main,Guard A,0,0,0,,‫ماذا آكل عندما أعود إلى البيت؟
Dialogue: 0,0:00:26.97,0:00:30.31,Main,Guard B,0,0,0,,‫لكنني قلتُ لك أن الأكبر أفضل.
Dialogue: 0,0:00:30.31,0:00:33.00,Main,Guard B,0,0,0,,‫إن كنا سنجعله يقاتل، \N‫فالأثقل هو الخيار الأفضل.
Dialogue: 0,0:00:33.81,0:00:36.48,Main,Guard B,0,0,0,,‫حسنًا، إذًا اذهب وابحث عنه واتصل لاحقًا.
Dialogue: 0,0:00:37.72,0:00:39.83,Main,Guard B,0,0,0,,‫ماذا؟ ليس هنا؟
Dialogue: 0,0:00:39.83,0:00:40.97,Main,Guard B,0,0,0,,‫هل ذهب إلى مكان ما؟
Dialogue: 0,0:00:41.77,0:00:44.36,Main,Guard B,0,0,0,,‫يا له من إزعاج. استراحة حمّام؟
Dialogue: 0,0:00:51.17,0:00:52.92,Main,Guard C,0,0,0,,‫انظر!
Dialogue: 0,0:00:54.10,0:00:55.99,Main,Guard C,0,0,0,,‫هل تظن أنه يأكل نقانق السمك؟
Dialogue: 0,0:00:57.13,0:00:59.17,Main,Guard D,0,0,0,,‫مهلًا، ألم يشارك هذا الشيء في البطولة؟
Dialogue: 0,0:00:59.55,0:01:01.62,Main,Guard C,0,0,0,,‫تفضل، هذه نقانق سمك.
Dialogue: 0,0:01:00.04,0:01:02.05,Main - Top,Guard D,0,0,0,,‫هيا، الباندا لا يأكل اللحم، كما تعلم.
Dialogue: 0,0:01:01.62,0:01:02.70,Main,Guard C,0,0,0,,‫إنها لذيذة.
Dialogue: 0,0:01:02.05,0:01:03.45,Main - Top,Guard D,0,0,0,,‫الخيزران. يأكل الخيزران.
Dialogue: 0,0:01:04.07,0:01:06.17,Main,Panda,0,0,0,,‫سآخذ نقانق السمك.
Dialogue: 0,0:01:08.50,0:01:11.42,Main,Panda,0,0,0,,‫لا توجد كاميرات على سلالم الطوارئ!
Dialogue: 0,0:01:12.02,0:01:13.07,Main,Panda,0,0,0,,‫مرحبًا!
Dialogue: 0,0:01:14.53,0:01:17.38,Main,Fushiguro,0,0,0,,‫باندا-سينباي، هل أنت متأكد حقًا؟
Dialogue: 0,0:01:17.89,0:01:20.10,Main,Fushiguro,0,0,0,,‫قد يسبب لك هذا مشاكل لاحقًا...
Dialogue: 0,0:01:20.59,0:01:22.69,Main,Panda,0,0,0,,‫لا بأس، لا بأس!
Dialogue: 0,0:01:22.69,0:01:25.01,Main,Panda,0,0,0,,‫فلنؤمّن المساحة قرب الباب.
Dialogue: 0,0:01:35.73,0:01:37.35,Main,Panda,0,0,0,,‫كيرارا!
Dialogue: 0,0:01:37.35,0:01:39.38,Main,Panda,0,0,0,,‫لماذا كيرارا ليست مع هيكاري؟!
Dialogue: 0,0:01:41.11,0:01:42.55,Main,Kirara,0,0,0,,‫باندا-تشان؟!
Dialogue: 0,0:01:43.20,0:01:45.75,Italics,Kirara,0,0,0,,‫وذلك الفتى ذو الشعر الشائك!
Dialogue: 0,0:01:46.78,0:01:49.64,Italics,Kirara,0,0,0,,‫إن كان باندا-تشان ساعده \N‫على التسلل إلى هنا،
Dialogue: 0,0:01:49.64,0:01:51.47,Italics,Kirara,0,0,0,,‫فهو مع ثانوية جوجيتسو؟!
Dialogue: 0,0:01:51.47,0:01:55.35,Italics,Kirara,0,0,0,,‫هذا يعني أن يو-تشان \N‫مع ثانوية جوجيتسو أيضًا!
Dialogue: 0,0:01:56.21,0:01:58.91,Italics,Kirara,0,0,0,,‫كين-تشان في خطر!
Dialogue: 0,0:01:59.30,0:02:01.66,Main,Yuji,0,0,0,,‫يا زعيم، أحتاج إلى—
Dialogue: 0,0:02:05.43,0:02:07.60,Main,Fushiguro,0,0,0,,‫كلاب الشيطان: الكلية!
Dialogue: 0,0:02:16.04,0:02:17.02,Main,Panda,0,0,0,,‫فوشيغورو؟!
Dialogue: 0,0:02:21.79,0:02:24.07,Italics,Fushiguro,0,0,0,,‫كلب الشيطان خاصتي دُفع للخلف؟!
Dialogue: 0,0:02:24.07,0:02:28.44,Italics,Fushiguro,0,0,0,,‫لا، بحسب ما قاله باندا-سينباي، \N‫لم يستطع الاقتراب!
Dialogue: 0,0:02:31.79,0:02:34.54,Italics,Kirara,0,0,0,,‫لقد وسمتُ باندا-تشان مسبقًا!
Dialogue: 0,0:02:39.27,0:02:40.90,Italics,Panda,0,0,0,,‫غرفة المراقبة!
Dialogue: 0,0:02:40.90,0:02:43.06,Italics,Panda,0,0,0,,‫كيرارا تخطط للعودة إلى هاكاري!
Dialogue: 0,0:02:43.06,0:02:44.56,Main,Panda,0,0,0,,‫انتظري يا كيرارا!
Dialogue: 0,0:02:44.56,0:02:46.11,Main,Panda,0,0,0,,‫لسنا أعداءك!
Dialogue: 0,0:02:46.11,0:02:48.36,Main,Panda,0,0,0,,‫نريد فقط أن نطلب من هاكاري خدمة!
Dialogue: 0,0:02:48.36,0:02:49.75,Main,Kirara,0,0,0,,‫لا أصدقك!
Dialogue: 0,0:02:49.75,0:02:51.56,Main,Kirara,0,0,0,,‫خاب ظني بك يا باندا-تشان!
Dialogue: 0,0:02:52.35,0:02:55.82,Main,Panda,0,0,0,,‫لا أستطيع الاقتراب منك أيضًا!
Dialogue: 0,0:02:59.12,0:03:01.68,Italics,Fushiguro,0,0,0,,‫إذًا كيرارا-سان \N‫لا تستطيع الاقتراب منا أيضًا؟
Dialogue: 0,0:03:03.71,0:03:04.83,Main,Panda,0,0,0,,‫فوشيغورو؟!
Dialogue: 0,0:03:04.83,0:03:07.23,Italics,Fushiguro,0,0,0,,‫الأمر أكثر من مجرد عدم القدرة \N‫على الاقتراب من كيرارا-سان.
Dialogue: 0,0:03:07.58,0:03:09.58,Italics,Fushiguro,0,0,0,,‫لا أستطيع حتى الانفصال \N‫عن كلاب الشيطان؟!
Dialogue: 0,0:03:09.58,0:03:11.21,Italics,Fushiguro,0,0,0,,‫أي نوع من التقنيات الملعونة هذه؟!
Dialogue: 0,0:03:12.91,0:03:14.02,Main,Yuji,0,0,0,,‫استمع لي!
Dialogue: 0,0:03:14.02,0:03:15.09,Main,Kinji,0,0,0,,‫مستحيل!
Dialogue: 0,0:03:15.09,0:03:16.76,Main,Kinji,0,0,0,,‫لقد برد حماسي الآن!
